# Copia este archivo a .env.local y rellena los valores. NUNCA subas .env.local.

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

ALLOWED_EMAIL=tu_correo@gmail.com
APP_TIMEZONE=Asia/Hong_Kong

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# 32 bytes en base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Secreto largo y aleatorio: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# Filtro obligatorio de Gmail (si falta, no se lee nada)
GMAIL_QUERY_FILTER=(from:tec.mx OR to:tu_matricula@tec.mx OR label:Tec)
PRIORITY_SENDERS=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

RESEND_API_KEY=
BRIEF_TO_EMAIL=tu_correo@gmail.com
